slnx.sqlite
ProjectSettings.json
VSWorkspaceState.json
CppProperties.json
.idea/
.vscode/

# Прочее
*.gch
*.log

# Сборка исполняемых файлов (PyInstaller)
build/
dist/
*.spec

# Собранный APK и инструменты сборки (скачиваются с Maven Central)
*.apk
*.jks
*.keystore
android/app/build/
android/.gradle/

# Сборка нативного транспорта (cpp/)
bhydra_bridge
*.o
