# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Состояние блокчейна B-hydra (генерируется при работе CLI)
wallet.key
bhydra_chain.json
qrcode.png
bhydra_peers.json
# Сертификат HTTPS и его ключ (создаются флагом --tls)
bhydra_cert.pem
bhydra_cert.key
# Иконки приложения — считаются b_hydra/icon.py при первом запросе
icon-192.png
icon-512.png
# Долговременный ключ УЗЛА: не кошелёк, но в репозиторий ему нельзя —
# кто его получил, тот выдаёт себя за этот узел.
bhydra_identity.json

# Среды разработки / IDE (Visual Studio, VS Code, JetBrains)
.vs/
*.sln
*.suo
*.user
*.vsidx
*.lnk
slnx.sqlite
ProjectSettings.json
VSWorkspaceState.json
CppProperties.json
.idea/
.vscode/

# Прочее
*.gch
*.log

# Сборка исполняемых файлов (PyInstaller)
build/
dist/
*.spec

# Собранный APK и инструменты сборки (скачиваются с Maven Central)
*.apk
*.jks
*.keystore
android/app/build/
android/.gradle/

# Сборка нативного кода (cpp/) — всё это собирается командами из CLAUDE.md,
# и ни одному собранному файлу в репозитории не место: они привязаны к
# машине и пересобираются из исходников. Раньше здесь стоял только
# bhydra_bridge, и libbhydra_ec.so чуть не уехала в коммит.
bhydra_bridge
bhydra_miner
bhydra_bt
*.o
*.so
*.dll
*.dylib
bhydra_miner.exe
bhydra_bt.exe
