# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# Состояние блокчейна B-hydra (генерируется при работе CLI)
wallet.key
bhydra_chain.json
qrcode.png
bhydra_peers.json
# Сертификат HTTPS и его ключ (создаются флагом --tls)
bhydra_cert.pem
bhydra_cert.key
# Иконки приложения — считаются b_hydra/icon.py при первом запросе
icon-192.png
icon-512.png
# Долговременный ключ УЗЛА: не кошелёк, но в репозиторий ему нельзя —
# кто его получил, тот выдаёт себя за этот узел.
bhydra_identity.json

# Среды разработки / IDE (Visual Studio, VS Code, JetBrains)
